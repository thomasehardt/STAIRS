FROM node:22-slim

WORKDIR /app

COPY package*.json ./

RUN npm install --legacy-peer-deps

# Fix permissions for the anonymous volume so non-root container users can write to node_modules (e.g. Vite temp files)
RUN chown -R node:node /app/node_modules

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
