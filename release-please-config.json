{
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "STAIRS",
      "extra-files": [
        {
          "type": "regex",
          "path": "services/web/package.json",
          "patterns": ["\"version\": \"(\\d+\\.\\d+\\.\\d+)\""]
        },
        {
          "type": "regex",
          "path": "services/api/pyproject.toml",
          "patterns": ["version = \"(\\d+\\.\\d+\\.\\d+)\""]
        },
        {
          "type": "regex",
          "path": "README.md",
          "patterns": [
            "STAIRS Astro Imaging Run Scheduler v(\\d+\\.\\d+\\.\\d+)"
          ]
        },
        {
          "type": "regex",
          "path": "docker-compose.prod.yaml",
          "patterns": [
            "stairs-api:v(\\d+\\.\\d+\\.\\d+)",
            "stairs-web:v(\\d+\\.\\d+\\.\\d+)",
            "stairs-cli:v(\\d+\\.\\d+\\.\\d+)"
          ]
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "sentence-case"
    }
  ]
}
