{
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "STAIRS",
      "extra-files": [
        {
          "type": "json",
          "path": "services/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "services/api/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "services/cli/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "docker-compose.prod.yaml"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "sentence-case"
    }
  ]
}
