FROM node:22-slim

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

COPY package.json pnpm-lock.yaml ./

# Install without scripts during build to get dependencies
RUN pnpm install --ignore-scripts

# Fix permissions for the anonymous volume so non-root container users can write to node_modules
RUN chown -R node:node /app/node_modules

COPY . .

EXPOSE 4321

# Run dev with a more permissive approach
CMD ["/bin/bash", "-c", "pnpm install && pnpm run dev -- --host 0.0.0.0"]
