---
// src/components/Interactive.astro
interface Props {
  src: string;
  title?: string;
  caption?: string;
  height?: number;
}

const { src, title = "Interactive Simulation", caption, height = 500 } = Astro.props;

const baseName = src.split('/').pop().replace('.html', '');
const uniqueId = Math.random().toString(36).substr(2, 9);
const containerId = `interactive-container-${baseName}-${uniqueId}`;
const jsPath = `/stairs-docs/interactives/${baseName}.js`;
---

<div class="interactive-outer-container"
     id={containerId}
     data-src={src}
     data-basename={baseName}
     data-jspath={jsPath}>
  <div class="interactive-toolbar">
    <span class="toolbar-title">{title}</span>
    <div class="popout-link">
      <a href={src} target="_blank" title="Open in new window">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        <span>Pop-out</span>
      </a>
    </div>
  </div>

  <div class="controls-container"></div>

  <div class="canvas-container" style={`min-height: ${height}px;`}>
    <div class="loading-overlay">
        <div class="spinner"></div>
    </div>
  </div>

  {caption && <div class="interactive-caption">{caption}</div>}
</div>

<style is:global>
  .interactive-outer-container .controls {
    background: #222;
    padding: 1rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-bottom: 1px solid #333;
    flex-wrap: wrap;
  }
  .interactive-outer-container .controls label {
    font-size: 0.8rem;
    color: #ccc;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .interactive-outer-container .controls button {
    background: var(--sl-color-gray-5);
    color: white;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 4px;
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .interactive-outer-container .controls button:hover {
    background: var(--sl-color-gray-4);
    border-color: var(--sl-color-gray-3);
  }
  .interactive-outer-container .controls button:active {
    background: var(--sl-color-gray-6);
    transform: translateY(1px);
  }
  .interactive-outer-container .controls button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .interactive-outer-container .controls input[type="radio"] {
    appearance: none;
    width: 14px;
    height: 14px;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 50%;
    background: #333;
    cursor: pointer;
    position: relative;
  }
  .interactive-outer-container .controls input[type="radio"]:checked {
    background: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }
  .interactive-outer-container .controls input[type="radio"]:checked::after {
    content: "";
    position: absolute;
    inset: 3px;
    background: white;
    border-radius: 50%;
  }
  .interactive-outer-container .controls select,
  .interactive-outer-container .controls input[type="range"] {
    background: #333;
    color: white;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    outline: none;
  }
  .interactive-outer-container .controls input[type="range"] {
      accent-color: var(--sl-color-text-accent);
  }
  .interactive-outer-container canvas {
      display: block;
      max-width: 100%;
      height: auto !important;
  }
</style>

<style>
  .interactive-outer-container {
    background: #171717;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 2.5rem 0;
    box-shadow: var(--sl-shadow-md);
    position: relative;
  }
  .interactive-toolbar {
    background: #222;
    padding: 0.6rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #333;
  }
  .toolbar-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .canvas-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #111;
    position: relative;
    overflow: hidden;
  }
  .interactive-caption {
    padding: 1rem;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
    font-style: italic;
    border-top: 1px solid #333;
    text-align: center;
  }
  .popout-link a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    font-weight: 600;
  }
  .popout-link a:hover {
    color: white;
  }
  .loading-overlay {
      position: absolute;
      inset: 0;
      background: #111;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 10;
      transition: opacity 0.5s;
  }
  .spinner {
    width: 30px;
    height: 30px;
    border: 3px solid rgba(255,255,255,0.1);
    border-top-color: var(--sl-color-text-accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.js"></script>
<script is:inline>
  (function() {
    async function initInteractive(el) {
      const src = el.getAttribute('data-src');
      const baseName = el.getAttribute('data-basename');
      const jsPath = el.getAttribute('data-jspath');
      const canvasContainer = el.querySelector('.canvas-container');
      const controlsContainer = el.querySelector('.controls-container');
      const loadingOverlay = el.querySelector('.loading-overlay');

      try {
        const htmlRes = await fetch(src);
        const htmlText = await htmlRes.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(htmlText, 'text/html');
        const controls = doc.querySelector('.controls');

        if (controls) {
            controlsContainer.innerHTML = controls.outerHTML;
        }

        const jsRes = await fetch(jsPath);
        const jsText = await jsRes.text();

        const sketch = (p) => {
            // Mock document for the script to scope it to the container
            const docMock = {
                getElementById: (id) => {
                    if (id === 'canvas-container') return canvasContainer;
                    // Try finding by ID within our container (controls or canvas area)
                    return el.querySelector('#' + id) || controlsContainer.querySelector('#' + id) || document.getElementById(id);
                },
                querySelector: (sel) => el.querySelector(sel) || controlsContainer.querySelector(sel),
                querySelectorAll: (sel) => {
                    const local = Array.from(el.querySelectorAll(sel));
                    const controls = Array.from(controlsContainer.querySelectorAll(sel));
                    return local.concat(controls);
                },
                getElementsByClassName: (cls) => {
                    const local = Array.from(el.getElementsByClassName(cls));
                    const controls = Array.from(controlsContainer.getElementsByClassName(cls));
                    return local.concat(controls);
                },
                getElementsByTagName: (tag) => {
                    const local = Array.from(el.getElementsByTagName(tag));
                    const controls = Array.from(controlsContainer.getElementsByTagName(tag));
                    return local.concat(controls);
                },
                addEventListener: (...args) => el.addEventListener(...args),
                removeEventListener: (...args) => el.removeEventListener(...args),
                createElement: (...args) => document.createElement(...args),
                body: el,
            };

            // Proxy to handle dynamic p5 variables and bound methods
            const context = new Proxy(p, {
                get: (target, prop) => {
                    if (prop === 'document') return docMock;
                    if (prop === 'window') return window;
                    if (prop === 'p5') return p5;
                    const val = target[prop];
                    if (typeof val === 'function') {
                        const bound = val.bind(target);
                        // Auto-parent the canvas to our container
                        if (prop === 'createCanvas') {
                            return (...args) => {
                                const c = bound(...args);
                                if (c && typeof c.parent === 'function') {
                                    // Proxy the parent method to intercept "canvas-container" string
                                    const originalParent = c.parent.bind(c);
                                    c.parent = function(parentTarget) {
                                        if (parentTarget === 'canvas-container') {
                                            return originalParent(canvasContainer);
                                        }
                                        return originalParent(parentTarget);
                                    };
                                    // Initial auto-parenting
                                    c.parent(canvasContainer);
                                }
                                return c;
                            };
                        }
                        return bound;
                    }
                    return val;
                },
                has: (target, prop) => {
                    if (prop === 'document' || prop === 'window' || prop === 'p5') return true;
                    return prop in target;
                }
            });

            const lifecycle = [
                'setup', 'draw', 'mouseClicked', 'mousePressed', 'mouseReleased',
                'mouseMoved', 'mouseDragged', 'mouseWheel', 'keyPressed',
                'keyReleased', 'keyTyped', 'windowResized'
            ];

            // Wrap script in with(context) to simulate global scope while remaining isolated
            // We use a self-executing function to ensure local 'let/const/var' don't leak or collide
            const wrappedScript = `
                return (function() {
                    with(context) {
                        ${jsText}
                        return { ${lifecycle.map(f => `${f}: typeof ${f} !== "undefined" ? ${f} : undefined`).join(', ')} };
                    }
                })()
            `;

            let exports = {};
            try {
                // Use non-strict function to allow 'with'
                const runScript = new Function('context', 'document', wrappedScript);
                exports = runScript(context, docMock);
            } catch (e) {
                console.error('Error in interactive script ' + baseName + ':', e);
            }

            p.setup = () => {
                // Let the script initialize its own canvas if it wants to
                if (exports.setup) {
                    exports.setup();
                } else {
                    // Fallback to default canvas if no setup defined
                    const canvas = p.createCanvas(canvasContainer.offsetWidth, canvasContainer.offsetHeight || 400);
                    canvas.parent(canvasContainer);
                }

                loadingOverlay.style.opacity = '0';
                setTimeout(() => loadingOverlay.remove(), 500);
            };

            // Map all lifecycle methods defined in the script
            lifecycle.forEach(f => {
                if (f === 'setup') return;
                if (exports[f]) {
                    p[f] = exports[f];
                }
            });

            // Default windowResized if not provided by script
            if (!p.windowResized) {
                p.windowResized = () => {
                    p.resizeCanvas(canvasContainer.offsetWidth, canvasContainer.offsetHeight || 400);
                };
            }
        };

        new p5(sketch);

      } catch (err) {
        console.error('Failed to load interactive:', err);
      }
    }

    function scan() {
        document.querySelectorAll('.interactive-outer-container:not(.initialized)').forEach(el => {
            el.classList.add('initialized');
            initInteractive(el);
        });
    }

    document.addEventListener('astro:page-load', scan);
    if (document.readyState === 'complete') scan();
    else window.addEventListener('load', scan);
  })();
</script>
